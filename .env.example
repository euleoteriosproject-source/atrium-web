# Public frontend configuration. Values remain optional during M0 local builds.
# Optional. Used only when testing Next dev server from another device on the local network.
# Accepts comma-separated hostnames or IP addresses.
# ALLOWED_DEV_ORIGINS=192.168.1.100,dev.local
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase provides its backend key directly to the Edge Function environment.
# Configure only these additional Edge Function secrets; do not expose them in the frontend.
TURNSTILE_SECRET_KEY=
TURNSTILE_TEST_MODE=
ALLOWED_ORIGINS=
EXPECTED_TURNSTILE_ACTION=create_lead
EXPECTED_TURNSTILE_HOSTNAME=

# Private configuration for the notify-new-lead Edge Function. Never expose as NEXT_PUBLIC_*.
LEAD_NOTIFICATION_EMAIL=
LEAD_NOTIFICATION_FROM=
LEAD_NOTIFICATION_PROVIDER_API_KEY=
LEAD_WEBHOOK_SECRET=

# Private configuration shared by the read-only and action Admin Lite Edge Functions.
# Comma-separated Supabase Auth user UUIDs. Never expose as NEXT_PUBLIC_*.
ADMIN_USER_IDS=
